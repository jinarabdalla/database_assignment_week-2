<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Budget Tracker</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <h1>Budget Tracker</h1>

  <!-- 1. HTML Table Structure -->
  <section class="table-section">
    <h2>Expense Overview</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Category</th>
          <th>Description</th>
          <th>Amount ($)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>2026-10-01</td>
          <td>Groceries</td>
          <td>Weekly supermarket trip</td>
          <td>120.00</td>
        </tr>
        <tr>
          <td>2026-10-03</td>
          <td>Utilities</td>
          <td>Electricity bill</td>
          <td>85.50</td>
        </tr>
        <tr>
          <td>2026-10-05</td>
          <td>Entertainment</td>
          <td>Movie tickets</td>
          <td>30.00</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- 2. Form Upgrade -->
  <section class="form-section">
    <h2>Add New Expense</h2>
    <form action="#" method="POST">
      <div>
        <label for="expense-category">Category:</label>
        <select id="expense-category" name="category" required>
          <option value="" disabled selected>Select a category</option>
          <option value="groceries">Groceries</option>
          <option value="utilities">Utilities</option>
          <option value="entertainment">Entertainment</option>
          <option value="transportation">Transportation</option>
          <option value="healthcare">Healthcare</option>
        </select>
      </div>

      <div>
        <label for="expense-amount">Amount:</label>
        <input type="number" id="expense-amount" name="amount" placeholder="0.00" step="0.01" required>
      </div>

      <div>
        <label for="expense-date">Date:</label>
        <input type="date" id="expense-date" name="date" required>
      </div>

      <button type="submit">Add Expense</button>
    </form>
  </section>

  <!-- 3. Multimedia Elements -->
  <section class="media-section">
    <h2>Financial Insights</h2>
    
    <!-- Image with required attributes -->
    <img src="https://via.placeholder.com/600x300" alt="Budgeting tips chart showing savings strategies" width="600" height="300">

    <!-- Iframe with required attributes -->
    <iframe 
      src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
      title="Personal Finance Tips" 
      width="560" 
      height="315" 
      allowfullscreen>
    </iframe>
  </section>

</body>
</html>
