/* style.css */

/* General Styling */
body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  margin: 20px;
  background-color: #f4f6f8;
  color: #333;
}

/* Base Table Styling */
table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 2rem;
  background-color: #ffffff;
}

th, td {
  padding: 12px;
  border: 1px solid #dddddd;
  text-align: left;
}

th {
  background-color: #2c3e50;
  color: white;
}

/* 4. Advanced CSS Selectors applied */

/* Selector 1: Pseudo-class selector (:nth-child) for alternating table row background */
tbody tr:nth-child(even) {
  background-color: #f9f9f9;
}

/* Selector 2: Attribute selector ([type="submit"]) targeting specific form buttons */
button[type="submit"] {
  background-color: #27ae60;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 1rem;
}

button[type="submit"]:hover {
  background-color: #219150;
}

/* Selector 3: Direct Child Combinator (section > h2) to style section headers specifically */
section > h2 {
  color: #2c3e50;
  border-bottom: 2px solid #2c3e50;
  padding-bottom: 5px;
  margin-top: 2rem;
}
